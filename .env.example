# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it contains secrets.
#
# See https://symfony.com/doc/current/configuration.html#managing-multiple-env-files

###> symfony/framework-bundle ###
# "dev" | "prod" | "test"
APP_ENV=dev

# Generate with: php bin/console secrets:generate-keys  or  openssl rand -hex 32
APP_SECRET=changeme_generate_a_random_32char_hex_string
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# PostgreSQL connection string. Update user/password/host/dbname to match your setup.
# Docker default (compose.override.yaml): postgresql://app:!ChangeMe!@database:5432/app?serverVersion=16&charset=utf8
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# Mailpit (local dev): smtp://localhost:1025
# Production SMTP example: smtp://user:pass@smtp.example.com:587?encryption=tls
MAILER_DSN=smtp://localhost:1025
###< symfony/mailer ###

###> prevention-platform ###
# Anthropic Claude API key — required for the AI "reasons to live" feature.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Absolute path (inside container) to the DB-IP country lite MMDB file.
# Run `make geoip` to download it. CC BY 4.0, no account required.
GEOIP_DB_PATH=/var/data/dbip-country-lite.mmdb

# Sender address and display name for follow-up check-in emails.
FOLLOWUP_FROM_EMAIL=checkin@yourdomain.help
FOLLOWUP_FROM_NAME="Someone cares"

# Public URL of the app — used in email links.
APP_URL=https://yourdomain.help
###< prevention-platform ###
