# Demo deployment environment — copy to .env.demo and fill in real values
# None of this file should be committed (it contains secrets)

# ——— Symfony ———————————————————————————————————————————————————————————————————
APP_ENV=prod

# Generate: openssl rand -hex 32
APP_SECRET=changeme_32char_hex

# ——— Database ————————————————————————————————————————————————————————————————
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme_strong_db_password
POSTGRES_DB=prevention

# ——— Server ——————————————————————————————————————————————————————————————————
# Your domain or IP. FrankenPHP will auto-provision a Let's Encrypt cert for domains.
# Use ":80" for plain HTTP on an IP address (no TLS).
SERVER_NAME=demo.yourdomain.help

# Public HTTPS URL (used in follow-up email links)
APP_URL=https://demo.yourdomain.help

# ——— AI ——————————————————————————————————————————————————————————————————————
ANTHROPIC_API_KEY=sk-ant-...

# ——— Email ——————————————————————————————————————————————————————————————————
# Mailpit is included in compose.demo.yaml — emails are captured locally.
# Replace with a real SMTP DSN for production.
MAILER_DSN=smtp://mailer:1025
FOLLOWUP_FROM_EMAIL=checkin@yourdomain.help
FOLLOWUP_FROM_NAME="Someone cares"

# ——— Demo password gate ————————————————————————————————————————————————————
# Username shown in the browser login dialog
DEMO_USERNAME=demo

# Bcrypt hash of the demo password.
# Generate with: make demo-hash p="yourpassword"
DEMO_PASSWORD_HASH=changeme_run_make_demo_hash
