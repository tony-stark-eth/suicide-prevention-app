{% extends 'base.html.twig' %}

{% block title %}{{ 'resources.page_title'|trans }} — {{ 'app.title'|trans }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 py-12">

    <h1 class="text-2xl font-light text-base-content mb-2">{{ 'resources.page_title'|trans }}</h1>
    <p class="text-base-content/50 text-sm mb-8">{{ 'resources.page_subtitle'|trans }}</p>

    <label for="country-select" class="block text-base-content/70 text-sm mb-2">
        {{ 'resources.country_select_label'|trans }}
    </label>
    <select
        id="country-select"
        aria-label="{{ 'resources.country_select_label'|trans }}"
        class="select select-bordered w-full text-sm mb-8"
        data-base-url="{{ path('resources') }}">
        {% for country in all_countries %}
        <option value="{{ country.code }}" {{ country.code == initial_country ? 'selected' : '' }}>
            {{ country.flagEmoji }} {{ country.nameEn }}
        </option>
        {% endfor %}
    </select>

    <div id="resource-list" aria-live="polite">
        {% include 'resources/_country.html.twig' %}
    </div>

</div>
{% endblock %}
