<div class="mt-4 pt-4 border-t border-stone-800 space-y-3 text-sm text-stone-400">
    <h3 class="text-stone-300 font-medium">{{ 'transparency.heading'|trans }}</h3>
    <p>{{ 'transparency.anonymous'|trans }}</p>
    <p>
        {% if country and not country.policeDispatchRisk %}
            {{ 'transparency.no_police_default'|trans }}
        {% else %}
            {{ 'transparency.police_risk_note'|trans }}
        {% endif %}
    </p>
    <p>{{ 'transparency.what_happens'|trans }}</p>
    <p>{{ 'transparency.confidential'|trans }}</p>
</div>
