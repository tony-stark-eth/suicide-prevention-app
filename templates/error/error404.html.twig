{% extends 'base.html.twig' %}

{% block title %}{{ 'error.not_found_title'|trans }}{% endblock %}

{% block body %}
<div class="max-w-md mx-auto px-4 py-24 text-center">
    <h1 class="text-2xl font-light text-base-content mb-4">{{ 'error.not_found_title'|trans }}</h1>
    <p class="text-base-content/70 text-sm mb-8">{{ 'error.not_found_body'|trans }}</p>
    <a href="{{ path('talk') }}"
       class="btn btn-error rounded-full shadow-xl">
        {{ 'talk.crisis_button'|trans }}
    </a>
</div>
{% endblock %}
