<!DOCTYPE html>
<html lang="{{ app.request.locale }}"
      class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="robots" content="index, follow">
    <meta name="csrf-token" content="{{ csrf_token('htmx') }}">
    <title>{% block title %}{{ 'app.title'|trans }}{% endblock %}</title>
    <meta name="description" content="{{ 'app.description'|trans }}">
    <script nonce="{{ csp_nonce('script') }}">(function(){var t=localStorage.getItem('theme');if(!t){var h=new Date().getHours(),d=window.matchMedia('(prefers-color-scheme: dark)').matches;t=(d||h>=20||h<7)?'warm-dark':'warm-light';}document.documentElement.setAttribute('data-theme',t);})();</script>
    {{ importmap('app', {nonce: csp_nonce('script')}) }}
</head>
<body class="min-h-screen bg-base-100 text-base-content font-sans antialiased">

    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 btn btn-primary btn-sm">
        {{ 'nav.skip_to_content'|trans }}
    </a>

    <nav class="border-b border-base-300 px-4 py-3" aria-label="{{ 'nav.main'|trans }}">
        <div class="max-w-2xl mx-auto flex items-center gap-4 sm:gap-6 text-sm">
            <a href="{{ path('home') }}"
               class="font-medium text-base-content hover:text-primary transition-colors shrink-0 {% if app.request.attributes.get('_route') in ['home','home_country'] %}text-primary{% endif %}"
               aria-label="{{ 'app.title'|trans }}">
                <span class="hidden sm:inline">{{ 'app.title'|trans }}</span>
                <svg class="sm:hidden w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path d="M10.707 2.293a1 1 0 0 0-1.414 0l-7 7A1 1 0 0 0 3 11h1v6a1 1 0 0 0 1 1h4v-4h2v4h4a1 1 0 0 0 1-1v-6h1a1 1 0 0 0 .707-1.707l-7-7Z"/>
                </svg>
            </a>
            <a href="{{ path('talk') }}"
               class="text-base-content/60 hover:text-base-content transition-colors {% if app.request.attributes.get('_route') == 'talk' %}text-base-content font-medium{% endif %}">
                {{ 'nav.talk'|trans }}
            </a>
            <a href="{{ path('plan') }}"
               class="text-base-content/60 hover:text-base-content transition-colors {% if app.request.attributes.get('_route') == 'plan' %}text-base-content font-medium{% endif %}">
                {{ 'nav.plan'|trans }}
            </a>
            <a href="{{ path('resources') }}"
               class="text-base-content/60 hover:text-base-content transition-colors {% if app.request.attributes.get('_route') in ['resources','resources_country'] %}text-base-content font-medium{% endif %}">
                {{ 'nav.resources'|trans }}
            </a>

            {# Language picker #}
            {% set locales = {
                'de': 'Deutsch',
                'en': 'English',
                'es': 'Español',
                'ja': '日本語',
                'ko': '한국어',
                'lt': 'Lietuvių',
                'ru': 'Русский',
                'uk': 'Українська'
            } %}
            {% set currentRoute = app.request.attributes.get('_route') %}
            {% set routeParams = app.request.attributes.get('_route_params') %}
            <div class="ml-auto dropdown dropdown-end">
                <button tabindex="0" role="button"
                        class="btn btn-ghost btn-xs gap-1 text-base-content/60 hover:text-base-content"
                        aria-label="{{ 'nav.language'|trans }}">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"/>
                    </svg>
                    <span class="uppercase font-medium">{{ app.request.locale }}</span>
                </button>
                <ul tabindex="0" class="dropdown-content menu bg-base-200 rounded-box z-50 w-36 p-1 shadow-lg border border-base-300">
                    {% for code, name in locales %}
                    <li>
                        <a href="{{ path(currentRoute, routeParams|merge({'_locale': code})) }}"
                           class="text-sm {% if app.request.locale == code %}font-medium text-primary{% endif %}"
                           {% if app.request.locale == code %}aria-current="true"{% endif %}>
                            {{ name }}
                        </a>
                    </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    </nav>

    <main id="main" class="pb-20">
        {% block body %}{% endblock %}
    </main>

    {% if app.request.attributes.get('_route') is not same as 'legal_impressum'
        and app.request.attributes.get('_route') is not same as 'legal_datenschutz' %}
    <div class="fixed right-4 z-50" style="bottom: calc(1rem + env(safe-area-inset-bottom, 0px))" role="region" aria-label="{{ 'talk.crisis_region_aria'|trans }}">
        <a href="{{ path('talk') }}"
           class="btn btn-error rounded-full shadow-xl text-sm px-5 py-3 gap-2"
           aria-label="{{ 'talk.crisis_button'|trans }}">
            {{ 'talk.crisis_button'|trans }}
        </a>
    </div>
    {% endif %}

    <footer class="border-t border-base-300 py-6 px-4 mt-16 text-center text-base-content/50 text-xs" style="padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px))">
        <a href="{{ path('legal_impressum') }}" class="hover:text-base-content mr-4 transition-colors">Impressum</a>
        <a href="{{ path('legal_datenschutz') }}" class="hover:text-base-content mr-4 transition-colors">Datenschutz</a>
        <span>{{ 'footer.no_data'|trans }}</span>
        <button id="theme-toggle"
                class="btn btn-ghost btn-xs ml-3 align-middle"
                aria-label="Switch to dark mode">
            <span data-sun aria-hidden="true" hidden>☀️</span>
            <span data-moon aria-hidden="true">🌙</span>
        </button>
    </footer>

</body>
</html>
