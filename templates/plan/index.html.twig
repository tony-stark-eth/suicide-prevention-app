{% extends 'base.html.twig' %}

{% block title %}{{ 'plan.title'|trans }} — {{ 'app.title'|trans }}{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto px-4 py-12"
     x-data="safetyPlan()"
     x-init="init()">

    <header class="mb-10">
        <h1 class="text-2xl font-light text-base-content mb-2">{{ 'plan.title'|trans }}</h1>
        <p class="text-base-content/50 text-sm">{{ 'plan.subtitle'|trans }}</p>
    </header>

    {# Step 1: AI Letter #}
    <section class="bg-base-200 border border-base-300 rounded-xl p-6 mb-6" aria-labelledby="step1-title">
        <h2 id="step1-title" class="text-base-content font-medium mb-1">{{ 'plan.step1_title'|trans }}</h2>
        <p class="text-base-content/50 text-sm mb-4">{{ 'plan.step1_desc'|trans }}</p>
        <input
            type="text"
            name="name"
            maxlength="50"
            placeholder="{{ 'plan.name_placeholder'|trans }}"
            aria-label="{{ 'plan.name_aria'|trans }}"
            hx-post="{{ path('api_reasons') }}"
            hx-trigger="keyup changed delay:800ms"
            hx-target="#letter-output"
            hx-swap="innerHTML"
            hx-indicator="#letter-loading"
            class="input input-bordered w-full text-sm"
        >
        <div id="letter-loading" class="htmx-indicator text-base-content/50 text-sm mt-2" aria-live="polite">
            {{ 'plan.generating'|trans }}
        </div>
        <div id="letter-output" aria-live="polite" aria-label="{{ 'plan.letter_region_aria'|trans }}"></div>
    </section>

    {# Step 2: Warning signs #}
    <section class="bg-base-200 border border-base-300 rounded-xl p-6 mb-6" aria-labelledby="step2-title">
        <h2 id="step2-title" class="text-base-content font-medium mb-1">{{ 'plan.step2_title'|trans }}</h2>
        <p class="text-base-content/50 text-sm mb-4">{{ 'plan.step2_desc'|trans }}</p>
        <template x-for="(sign, i) in warningSigns" :key="i">
            <div class="flex gap-2 mb-2">
                <input type="text"
                       x-model="warningSigns[i]"
                       placeholder="{{ 'plan.warning_placeholder'|trans }}"
                       class="input input-bordered input-sm flex-1"
                       :aria-label="'{{ 'plan.step2_title'|trans }} ' + (i + 1)">
                <button type="button" @click="removeItem('warningSigns', i)"
                        class="btn btn-ghost btn-sm btn-square"
                        aria-label="Remove">✕</button>
            </div>
        </template>
        <button type="button" @click="addItem('warningSigns', '')"
                class="btn btn-ghost btn-xs text-primary mt-1">
            {{ 'plan.add_warning'|trans }}
        </button>
    </section>

    {# Step 3: Coping strategies #}
    <section class="bg-base-200 border border-base-300 rounded-xl p-6 mb-6" aria-labelledby="step3-title">
        <h2 id="step3-title" class="text-base-content font-medium mb-4">{{ 'plan.step3_title'|trans }}</h2>
        <template x-for="(strategy, i) in copingStrategies" :key="i">
            <div class="flex gap-2 mb-2">
                <input type="text"
                       x-model="copingStrategies[i]"
                       placeholder="{{ 'plan.coping_placeholder'|trans }}"
                       class="input input-bordered input-sm flex-1"
                       :aria-label="'{{ 'plan.step3_title'|trans }} ' + (i + 1)">
                <button type="button" @click="removeItem('copingStrategies', i)"
                        class="btn btn-ghost btn-sm btn-square" aria-label="Remove">✕</button>
            </div>
        </template>
        <button type="button" @click="addItem('copingStrategies', '')"
                class="btn btn-ghost btn-xs text-primary mt-1">
            {{ 'plan.add_coping'|trans }}
        </button>
    </section>

    {# Step 4: Trusted contacts #}
    <section class="bg-base-200 border border-base-300 rounded-xl p-6 mb-6" aria-labelledby="step4-title">
        <h2 id="step4-title" class="text-base-content font-medium mb-1">{{ 'plan.step4_title'|trans }}</h2>
        <p class="text-base-content/50 text-sm mb-4">{{ 'plan.step4_desc'|trans }}</p>
        <template x-for="(contact, i) in trustedContacts" :key="i">
            <div class="flex gap-2 mb-2">
                <input type="text" x-model="trustedContacts[i].name"
                       placeholder="{{ 'plan.contact_name'|trans }}"
                       class="input input-bordered input-sm flex-1"
                       :aria-label="'{{ 'plan.contact_name'|trans }} ' + (i + 1)">
                <input type="tel" x-model="trustedContacts[i].phone"
                       placeholder="{{ 'plan.contact_phone'|trans }}"
                       class="input input-bordered input-sm flex-1"
                       :aria-label="'{{ 'plan.contact_phone'|trans }} ' + (i + 1)">
                <button type="button" @click="removeItem('trustedContacts', i)"
                        class="btn btn-ghost btn-sm btn-square" aria-label="Remove">✕</button>
            </div>
        </template>
        <button type="button" @click="addItem('trustedContacts', {name: '', phone: ''})"
                class="btn btn-ghost btn-xs text-primary mt-1">
            {{ 'plan.add_contact'|trans }}
        </button>
    </section>

    {# Step 5: Reasons #}
    <section class="bg-base-200 border border-base-300 rounded-xl p-6 mb-6" aria-labelledby="step5-title">
        <h2 id="step5-title" class="text-base-content font-medium mb-1">{{ 'plan.step5_title'|trans }}</h2>
        <p class="text-base-content/50 text-sm mb-4">{{ 'plan.step5_desc'|trans }}</p>
        <template x-for="(reason, i) in reasons" :key="i">
            <div class="flex gap-2 mb-2">
                <input type="text" x-model="reasons[i]"
                       placeholder="{{ 'plan.reason_placeholder'|trans }}"
                       class="input input-bordered input-sm flex-1"
                       :aria-label="'{{ 'plan.step5_title'|trans }} ' + (i + 1)">
                <button type="button" @click="removeItem('reasons', i)"
                        class="btn btn-ghost btn-sm btn-square" aria-label="Remove">✕</button>
            </div>
        </template>
        <button type="button" @click="addItem('reasons', '')"
                class="btn btn-ghost btn-xs text-primary mt-1">
            {{ 'plan.add_reason'|trans }}
        </button>
    </section>

    {# Save + Export #}
    <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <button type="button" @click="exportPdf()"
                class="btn btn-neutral btn-sm flex-1">
            {{ 'plan.export_pdf'|trans }}
        </button>
        <p class="text-base-content/40 text-xs" x-show="savedAt" x-text="'{{ 'plan.saved_indicator'|trans }}'"></p>
    </div>

    <p class="text-base-content/40 text-xs mt-4 text-center">{{ 'plan.bookmark_tip'|trans }}</p>

    {# Follow-up opt-in #}
    <div class="mt-10 bg-base-200 border border-base-300 rounded-xl p-6">
        <h2 class="text-base-content font-medium mb-1">{{ 'followup.title'|trans }}</h2>
        <p class="text-base-content/50 text-sm mb-4">{{ 'followup.desc'|trans }}</p>
        <div id="followup-form"
             hx-post="{{ path('followup_optin') }}"
             hx-target="#followup-form"
             hx-swap="outerHTML"
             hx-trigger="submit">
            <form>
                <div class="flex gap-2">
                    <input type="email" name="email" required
                           placeholder="{{ 'followup.email_placeholder'|trans }}"
                           aria-label="{{ 'followup.email_placeholder'|trans }}"
                           class="input input-bordered input-sm flex-1">
                    <button type="submit" class="btn btn-primary btn-sm">
                        {{ 'followup.submit'|trans }}
                    </button>
                </div>
            </form>
        </div>
        <p class="text-base-content/40 text-xs mt-2">{{ 'followup.privacy_note'|trans }}</p>
    </div>

</div>
{% endblock %}
