{% if rate_limited is defined and rate_limited %}
<div class="mt-4 p-4 bg-base-300 rounded-xl border border-base-300 text-base-content/70 text-sm">
    {{ 'plan.rate_limited'|trans }}
</div>
{% elseif letter %}
<div class="mt-4 p-5 bg-base-300 rounded-xl border border-base-300 space-y-3">
    {% for paragraph in letter|split("\n\n") %}
        {% if paragraph|trim %}
        <p class="text-base-content/90 leading-relaxed text-sm">{{ paragraph|trim }}</p>
        {% endif %}
    {% endfor %}
    <div class="pt-3 border-t border-base-300 mt-4">
        <p class="text-base-content/50 text-xs">{{ 'plan.letter_transition'|trans }}</p>
    </div>
</div>
{% endif %}
